{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Status 422 when status field is missing",
  "description": "对应 PUT /device/{device_id}/status 传 json={}、缺少 status 字段时的响应体",
  "type": "object",
  "required": ["detail"],
  "additionalProperties": false,
  "properties": {
    "detail": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["type", "loc", "msg", "input"],
        "additionalProperties": true,
        "properties": {
          "type": {
            "type": "string",
            "const": "missing"
          },
          "loc": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": [
              { "type": "string", "const": "body" },
              { "type": "string", "const": "status" }
            ]
          },
          "msg": {
            "type": "string",
            "const": "Field required"
          },
          "input": {
            "type": "object",
            "maxProperties": 0
          },
          "url": {
            "type": "string"
          }
        }
      }
    }
  }
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FastAPI 422 Validation Error",
  "description": "对应 POST /device/register 入参校验失败时的响应体（Pydantic v2）",
  "type": "object",
  "required": ["detail"],
  "additionalProperties": false,
  "properties": {
    "detail": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["type", "loc", "msg"],
        "additionalProperties": true,
        "properties": {
          "type": {
            "type": "string",
            "examples": ["string_too_short", "string_too_long", "missing"]
          },
          "loc": {
            "type": "array",
            "minItems": 1,
            "items": {
              "oneOf": [
                { "type": "string" },
                { "type": "integer" }
              ]
            }
          },
          "msg": {
            "type": "string",
            "minLength": 1
          },
          "input": true,
          "ctx": {
            "type": "object"
          },
          "url": {
            "type": "string"
          }
        }
      }
    }
  }
}

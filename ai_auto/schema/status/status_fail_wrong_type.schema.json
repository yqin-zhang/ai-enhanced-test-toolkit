{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Status 422 when status is not a string",
  "description": "对应 PUT /device/{device_id}/status 的 status 为数字或 null 时的响应体",
  "type": "object",
  "required": ["detail"],
  "additionalProperties": false,
  "properties": {
    "detail": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["type", "loc", "msg", "input"],
        "additionalProperties": true,
        "properties": {
          "type": {
            "type": "string",
            "const": "string_type"
          },
          "loc": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": [
              { "type": "string", "const": "body" },
              { "type": "string", "const": "status" }
            ]
          },
          "msg": {
            "type": "string",
            "const": "Input should be a valid string"
          },
          "input": {
            "anyOf": [
              { "type": "integer" },
              { "type": "null" }
            ]
          },
          "url": {
            "type": "string"
          }
        }
      }
    }
  }
}

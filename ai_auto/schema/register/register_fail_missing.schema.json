{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Register 422 when request body is missing",
  "description": "对应 POST /device/register 未传 body（body 为 null）时的响应体",
  "type": "object",
  "required": ["detail"],
  "additionalProperties": false,
  "properties": {
    "detail": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["type", "loc", "msg", "input"],
        "additionalProperties": true,
        "properties": {
          "type": {
            "type": "string",
            "const": "missing"
          },
          "loc": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "enum": ["body"]
            }
          },
          "msg": {
            "type": "string",
            "const": "Field required"
          },
          "input": {
            "type": "null"
          },
          "url": {
            "type": "string"
          }
        }
      }
    }
  }
}

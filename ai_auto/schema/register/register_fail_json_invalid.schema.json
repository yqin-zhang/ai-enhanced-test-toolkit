{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Register 422 when JSON syntax is invalid",
  "description": "对应 POST /device/register 声明了 application/json 但 JSON 语法错误时的响应体",
  "type": "object",
  "required": ["detail"],
  "additionalProperties": false,
  "properties": {
    "detail": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["type", "loc", "msg", "ctx"],
        "additionalProperties": true,
        "properties": {
          "type": {
            "type": "string",
            "const": "json_invalid"
          },
          "loc": {
            "type": "array",
            "minItems": 2,
            "items": [
              { "type": "string", "const": "body" },
              { "type": "integer", "minimum": 0 }
            ]
          },
          "msg": {
            "type": "string",
            "const": "JSON decode error"
          },
          "input": {
            "type": "object"
          },
          "ctx": {
            "type": "object",
            "required": ["error"],
            "properties": {
              "error": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "url": {
            "type": "string"
          }
        }
      }
    }
  }
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Delete device success response",
  "description": "对应 DELETE /device/{device_id} 成功时的响应体",
  "type": "object",
  "required": ["code", "msg"],
  "additionalProperties": false,
  "properties": {
    "code": {
      "type": "integer",
      "const": 0
    },
    "msg": {
      "type": "string",
      "const": "删除成功"
    }
  }
}

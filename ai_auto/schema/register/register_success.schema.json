{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Register success response",
  "description": "对应 POST /device/register 注册成功时的响应体",
  "type": "object",
  "required": ["code", "msg", "data"],
  "additionalProperties": false,
  "properties": {
    "code": {
      "type": "integer",
      "const": 0
    },
    "msg": {
      "type": "string",
      "const": "注册成功"
    },
    "data": {
      "type": "object",
      "required": ["device_id"],
      "additionalProperties": false,
      "properties": {
        "device_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      }
    }
  }
}
